# Supabase (Postgres + Storage) — create a project, run supabase/migrations/0001_init.sql
# in the SQL editor, and create two public-read storage buckets: "uploads" and "print-files".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — test mode keys while developing. Register the webhook endpoint
# (/api/webhooks/stripe) in the Stripe Dashboard once deployed, or use the
# Stripe CLI locally: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Gelato — leave GELATO_DRY_RUN=true until a real API key + product UIDs
# (product_variants.gelato_product_uid) are set up in the Gelato dashboard.
GELATO_API_KEY=
GELATO_API_BASE_URL=https://order.gelatoapis.com/v3
GELATO_DRY_RUN=true

# Admin (/admin, /api/admin) — required, the app fails closed without these.
ADMIN_USER=
ADMIN_PASSWORD=

# Operator order notifications (optional — skipped with a console warning if unset)
RESEND_API_KEY=
OPERATOR_NOTIFY_EMAIL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta Pixel — reused from Velle's pre-existing ad account (see
# content-generator/brands/velle/README.md). Fires PageView/ViewContent/
# InitiateCheckout/Purchase (see components/MetaPixel.tsx, TrackPurchase.tsx).
NEXT_PUBLIC_META_PIXEL_ID=
